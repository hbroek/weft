# Copy to /etc/weft-backup.env on the VPS: owner root, mode 600 (systemd reads it as root; the weft user never sees the file).
#   install -m 600 -o root -g root weft-backup.env.example /etc/weft-backup.env && nano /etc/weft-backup.env
# Nothing secret belongs in the repository: fill in the real values only on the VPS.

# Cloudflare R2 (S3 compatible). ACCOUNT_ID is on the R2 overview page; BUCKET is the bucket you made.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Encrypts everything before it leaves the machine. Keep a copy somewhere else too (password manager):
# without it the backups cannot be read, by anyone.
RESTIC_PASSWORD=
RESTIC_CACHE_DIR=/var/cache/weft-backup

# Optional: the ping address of a heartbeat monitor, like https://host/ping/TOKEN. A fully successful run pings it;
# a failed run reports the step that failed to the same address plus /fail?msg=...
HEARTBEAT_URL=
