# Copy to .env (next to compose.yaml) and fill in.
# The address of your Weft: weft.<a domain you own> is the usual choice. Point an A record for it at this machine.
WEFT_HOST=weft.example.com
# The name of your account, made at the first start (letters and digits; "weft" and "www" are reserved).
WEFT_USER=me
# Let's Encrypt writes here if something is wrong with the certificate. Not shown to anyone.
ACME_EMAIL=you@example.com
# Only for compose.tunnel.yaml (Cloudflare Tunnel): the tunnel's token from the Cloudflare dashboard. Keep it private.
# TUNNEL_TOKEN=
